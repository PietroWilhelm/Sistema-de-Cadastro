@{
    ViewData["Title"] = "Confirmação de apagar contato";
}

<div class="text-center">
    <h3>Realmente deseja apagar o contato (nome dinamico que deve vir)?</h3>
    <a class="btn btn-primary" role="button" asp-controller="Contato" asp-action="Index" >Cancelar exclusão</a>
    <a class="btn btn-danger" role="button" asp-controller="Contato" asp-action="apagar" >Confirmar exclusão</a>
</div>


