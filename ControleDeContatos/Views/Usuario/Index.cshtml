@using ControleDeContatos.Models.Usuario

@model List<UsuarioModel> 

@{ 
    ViewData["Title"] = "Listagem de Usuários";
}

<!-- asp-controller="" indica de onde vem, já asp-action="" para onde vai/qual ação vai realizar -->
<div class="text-center" role="group">
    
    <div class="d-grid gap-2 d-md-flex justify-content-md-start" role="group">
        <a role="button" class="btn btn-success" asp-controller="Usuario" asp-action="Criar">+ Adicionar novo Usuário</a>
    </div>
    <br/>
    
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show position-relative" role="alert">
            @TempData["MensagemSucesso"]
            <button type="button" class="alert-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
        </div>    
    } 
    
    
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensagemErro"]
            <button type="button" class="alert-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
        </div>
    } 

    <br/>
    
    <h1 class="display-4">Listagem de usuários</h1>
    <table class="table" id="table-usuarios">
        <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Nome</th>
            <th scope="col">Login</th>
            <th scope="col">E-mail</th>
            <th scope="col">Data de cadastro</th>
            <th scope="col"></th>
        </tr>
        </thead>
        <tbody>
        <!--- verifica se o model não é nulo e se possui elementos  --->
        @if (Model != null && Model.Any())
        {
            foreach (UsuarioModel usuario in Model)
            {
                <tr>
                    <th scope="row">@usuario.Id</th>
                    <td>@usuario.Nome</td>
                    <td>@usuario.Login</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.DataCadastro</td>
                    <td>
                        <!---asp-route-id= indica o id que desejo acessar seja apagando ou editando  --->
                        <div class="btn-group" role="group">
                            <a role="button" class="btn btn-primary" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="Editar">Editar</a>
                            <a role="button" class="btn btn-danger" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="ApagarConfirmacao">Apagar</a>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
