@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Acesso Restrito";
}

<div class="container text-center mt-5">
    <div class="card mx-auto shadow-sm" style="max-width: 520px;">
        <div class="card-body p-5">
            <div class="display-1 text-warning mb-3" aria-hidden="true">&#128274;</div>
            <h1 class="h3 mb-3">Acesso restrito</h1>
            <p class="text-muted mb-4">
                Você não tem permissão para acessar esta funcionalidade.
                Ela está disponível apenas para administradores do sistema.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Voltar para o início</a>
                <a class="btn btn-outline-secondary" asp-controller="Login" asp-action="Sair">Sair</a>
            </div>
        </div>
    </div>
</div>
